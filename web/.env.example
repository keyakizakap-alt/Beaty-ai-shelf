# 無料診断で使うAI（測る対象）。キーが無いAIは使われません。どちらも無い場合、無料診断は「準備中」と表示されます。
# キーはこのファイルに書かず、ローカルでは .env.local、本番では Vercel の環境変数に登録してください。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 費用の上限（アプリ側）。各社の管理画面でも必ず利用上限を設定してください。
DIAGNOSIS_QUESTIONS=6
DIAGNOSIS_PER_IP_LIMIT=3
DIAGNOSIS_DAILY_LIMIT=50
